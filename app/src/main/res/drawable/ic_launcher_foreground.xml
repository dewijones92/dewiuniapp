<?xml version="1.0" encoding="utf-8"?>
<!--
  Totum's mark: a chunky play triangle whose point radiates two broadcast arcs — watching
  and listening in one shape, which is the whole point of the app.

  Two implementation notes:
  - The triangle's rounded corners come from stroking the same path in the same colour
    with a round line-join, rather than from hand-computed corner curves. Same result,
    and the geometry stays readable.
  - Everything sits within x,y 21..87, the safe zone an adaptive icon guarantees is
    visible whatever mask the launcher applies.

  White on transparent, so this doubles as the monochrome (themed-icon) layer: Android
  tints monochrome drawables by alpha.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M30,38 L30,70 L58,54 Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <path
        android:pathData="M66,42.5 A14,14 0 0 1 66,65.5"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <path
        android:pathData="M71.2,35.2 A23,23 0 0 1 71.2,72.8"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
