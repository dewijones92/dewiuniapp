<?xml version="1.0" encoding="utf-8"?>
<!--
  Totum's launcher background: brand tangerine, lighter at the top-left so the icon has
  some depth at large sizes. The hex values are duplicated from theme/Color.kt because a
  vector drawable can't reference Compose values — Color.kt stays the palette's single
  source of truth, and this is the one place it is deliberately mirrored.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="4"
                android:endX="100"
                android:endY="104"
                android:type="linear">
                <item android:color="#FFFFA05C" android:offset="0.0" />
                <item android:color="#FFFF7A1F" android:offset="0.55" />
                <item android:color="#FFE85D04" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
